# Plantilla de configuración. Copia este archivo a .env (no se usa .env.local).
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Login con Google: deshabilitado por defecto. Pon true para mostrar el botón
# y habilitar /api/auth/google y su callback.
GOOGLE_OAUTH_ENABLED=false
# Dominio permitido para altas de usuario (registro, panel y Google).
ALLOWED_EMAIL_DOMAIN=example.org
# Dominio fijo del túnel ngrok, sin https://. Solo desarrollo.
# Ejemplo: NGROK_DOMAIN=mi-dominio.ngrok-free.dev
NGROK_DOMAIN=
ADMIN_EMAIL=
# Solo lo usa `npm run db:create-admin`; la app no lo lee en runtime.
ADMIN_PASSWORD=
ADMIN_NAME=Administración
# Rol de `npm run db:create-admin`. Super_admin por defecto, también en el código:
# es el mecanismo de ruptura y un admin no puede crear super_admins.
# Pon admin solo si lo que quieres es precisamente un admin.
ADMIN_ROLE=super_admin

POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5433
DATABASE_URL=postgresql://app_user:cambiar-esta-clave@127.0.0.1:5433/app_db?sslmode=disable
DATABASE_URL_INTERNAL=postgresql://app_user:cambiar-esta-clave@postgres:5432/app_db?sslmode=disable
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# pgAdmin 4 (perfil db-tools) -> http://127.0.0.1:5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# Storage de archivos (S3/MinIO). Las credenciales NO tienen valor por defecto:
# rellena ACCESS_KEY y SECRET_KEY con valores reales o deja el perfil local-storage
# desactivado. La app falla al arrancar si faltan.
# Credenciales del servicio MinIO (perfil local-storage) -> consola en http://127.0.0.1:9001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ENDPOINT_INTERNAL=http://minio:9000
# Credenciales que usa la app para leer/escribir en el bucket
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true

# Nivel de logs de la aplicacion: debug | info | warn | error
LOG_LEVEL=info

# Servidor Ollama. Ajusta host/puerto y modelos a tu despliegue.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_AGENT_MODEL=qwen3:14b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_CHAT_CONTEXT_LENGTH=32768
OLLAMA_AGENT_CONTEXT_LENGTH=49152
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.3
OLLAMA_CHAT_KEEP_ALIVE=-1
OLLAMA_AGENT_KEEP_ALIVE=5m
OLLAMA_EMBEDDING_KEEP_ALIVE=0
OLLAMA_TIMEOUT_MS=120000
OLLAMA_EMBEDDING_TIMEOUT_MS=30000
MAX_UPLOAD_MB=20
SEARXNG_URL=http://127.0.0.1:4000

# Generación de documentos (DOCX -> PDF con LibreOffice headless).
# Vacío = autodetección (PATH, /usr/bin/soffice o Program Files en Windows).
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_BIN=
# libreoffice = maquetación rica; pdf-lib = fallback simple sin LibreOffice.
DOC_PDF_ENGINE=libreoffice
DOC_MAX_PAGES=10
DOC_CONVERSION_TIMEOUT_MS=60000
# Conversiones simultáneas de LibreOffice. Mantener bajo (1-2) para no saturar.
DOC_CONVERSION_CONCURRENCY=2
# Tras un fallo de LibreOffice se usa pdf-lib durante este tiempo (circuit breaker).
DOC_LIBREOFFICE_COOLDOWN_MS=60000

# Timeout de inactividad para streaming con Ollama: si no llega ningún token
# durante este tiempo (ms) se aborta la generación. Se reinicia con cada token.
OLLAMA_STREAM_IDLE_TIMEOUT_MS=120000

# Tiempo máximo total para generar un documento (ms). Default: 5 min.
DOC_OLLAMA_TIMEOUT_MS=300000

# Dominio público para Caddy (perfil proxy). Solo si hay DNS/TLS.
PUBLIC_DOMAIN=
# Rama que despliega deploy/deploy.ps1 en el servidor.
DEPLOY_BRANCH=main

# -- Generación de imágenes (FLUX.2 Klein 4B + ComfyUI) ----------------------
# true = habilita el botón y la detección de intención. El endpoint /api/chat
# sigue siendo el único punto de creación.
IMAGE_ENABLED=true
# flux2-klein = ComfyUI real; mock = PNG sintético para tests sin GPU.
IMAGE_BACKEND=flux2-klein
# Desde el host (npm run dev + worker local): http://127.0.0.1:8188
# Desde Docker: COMFYUI_URL_DOCKER=http://host.docker.internal:8188 y el túnel
# SSH debe escuchar en el host Docker. 127.0.0.1 dentro del contenedor es el
# propio contenedor, no la máquina con GPU.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_URL_DOCKER=http://host.docker.internal:8188
# Ruta LOCAL al JSON del workflow. Es opcional: el grafo FLUX.2 Klein se
# construye en código y esta ruta solo se valida/comprueba legibilidad. La ruta
# de la máquina con GPU no es visible para el worker.
COMFYUI_WORKFLOW=
COMFYUI_MODEL=flux-2-klein-4b-fp8.safetensors
COMFYUI_CLIP_MODEL=qwen_3_4b.safetensors
COMFYUI_VAE_MODEL=flux2-vae.safetensors
COMFYUI_DEFAULT_WIDTH=1024
COMFYUI_DEFAULT_HEIGHT=1024
COMFYUI_STEPS=4
COMFYUI_SEED=42
COMFYUI_TIMEOUT_MS=300000
COMFYUI_POLL_MS=1000
COMFYUI_FILENAME_PREFIX=flux2-klein
# Solo activarlo si el ComfyUI instalado soporta cancelación dirigida por
# prompt_id. Nunca se llama /interrupt sin prompt_id.
COMFYUI_TARGETED_CANCEL=false

# Límites de la API y del worker. 1 MP es el punto de partida acordado.
IMAGE_MAX_PIXELS=1100000
IMAGE_PROMPT_MAX_CHARS=2000
IMAGE_MAX_REFERENCES=4
IMAGE_MAX_REFERENCE_MB=10
IMAGE_MAX_REFERENCE_DIMENSION=8192
IMAGE_MAX_OUTPUT_MB=20
IMAGE_MAX_ACTIVE_JOBS_PER_USER=2
IMAGE_MAX_ACTIVE_JOBS_PER_CHAT=3
IMAGE_RATE_LIMIT_PER_MINUTE=5
IMAGE_WORKER_CONCURRENCY=1
IMAGE_WORKER_POLL_MS=1500
IMAGE_WORKER_HEARTBEAT_MS=5000
IMAGE_WORKER_STALE_MS=60000
IMAGE_JOB_MAX_ATTEMPTS=2
# Refinado e intención usan Ollama. En tests: IMAGE_PROMPT_REFINE=false e
# IMAGE_INTENT_USE_OLLAMA=false.
IMAGE_PROMPT_MODEL=
IMAGE_PROMPT_REFINE=true
IMAGE_PROMPT_TIMEOUT_MS=20000
IMAGE_INTENT_MODEL=
IMAGE_INTENT_USE_OLLAMA=true
IMAGE_INTENT_TIMEOUT_MS=5000
IMAGE_INTENT_MIN_CONFIDENCE=0.72
IMAGE_MOCK_DELAY_MS=25
