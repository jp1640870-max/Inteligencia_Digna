NODE_ENV=development
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administración
# Rol de `npm run db:create-admin`. Super_admin por defecto, también en el código:
# es el mecanismo de ruptura y un admin no puede crear super_admins.
# Pon admin solo si lo que quieres es precisamente un admin.
ADMIN_ROLE=super_admin

POSTGRES_DB=inteligencia_digna
POSTGRES_USER=inteligencia_digna
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5433
DATABASE_URL=postgresql://inteligencia_digna:cambiar-esta-clave@127.0.0.1:5433/inteligencia_digna?sslmode=disable
DATABASE_URL_INTERNAL=postgresql://inteligencia_digna:cambiar-esta-clave@postgres:5432/inteligencia_digna?sslmode=disable
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# pgAdmin 4 (perfil db-tools) -> http://127.0.0.1:5050
PGADMIN_EMAIL=admin@digna.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# Storage de archivos (S3/MinIO). Las credenciales NO tienen valor por defecto:
# rellena ACCESS_KEY y SECRET_KEY con valores reales o deja el perfil local-storage
# desactivado. La app falla al arrancar si faltan.
# Credenciales del servicio MinIO (perfil local-storage) -> consola en http://127.0.0.1:9001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ENDPOINT_INTERNAL=http://minio:9000
MINIO_USE_SSL=false
# Credenciales que usa la app para leer/escribir en el bucket
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=attachments
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true

# Ruta del SQLite legacy, solo para `npm run db:import` (una vez, sobre BD vacia)
SQLITE_PATH=data/app.db
# Nivel de logs de la aplicacion: debug | info | warn | error
LOG_LEVEL=info

OLLAMA_URL=http://10.0.201.10:51234
OLLAMA_CHAT_MODEL=inteligencia-digna:qwen3.8-chat
OLLAMA_AGENT_MODEL=inteligencia-digna:qwen3.6-agents
OLLAMA_EMBEDDING_MODEL=inteligencia-digna:bge-m3-rag
OLLAMA_CHAT_CONTEXT_LENGTH=32768
OLLAMA_AGENT_CONTEXT_LENGTH=49152
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.3
OLLAMA_CHAT_KEEP_ALIVE=-1
OLLAMA_AGENT_KEEP_ALIVE=5m
OLLAMA_EMBEDDING_KEEP_ALIVE=0
OLLAMA_TIMEOUT_MS=120000
OLLAMA_EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_DIMENSIONS=1024
MAX_UPLOAD_MB=20
SEARXNG_URL=http://127.0.0.1:4000
