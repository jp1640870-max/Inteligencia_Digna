{
  "name": "mi-ia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:next": "next dev --experimental-https",
    "dev:login": "concurrently \"next dev --experimental-https\" \"wait-on https://lvh.me:3000 && start https://lvh.me:3000/login\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "NODE_ENV=test OLLAMA_URL=${OLLAMA_URL:-http://127.0.0.1:1} tsx --test --env-file=tests/.env.test \"tests/*.test.ts\"",
    "smoke:db": "tsx scripts/db-smoke.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:import": "tsx scripts/db-import-sqlite.ts",
    "db:reindex": "tsx scripts/db-reindex-embeddings.ts",
    "db:create-admin": "tsx scripts/seed.ts",
    "storage:init": "tsx scripts/storage-init.ts",
    "db:query": "tsx scripts/db-query.ts",
    "db:reset-password": "node --env-file=.env.local scripts/reset-password.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.0",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "pdf2json": "^4.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
